<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/app_icon"
        android:label="Graffiti Hunter"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity android:name=".HunterHomeActivity"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="fullUser"
            android:configChanges="mcc|mnc|locale|layoutDirection|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|density"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".NativeCameraCaptureActivity"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="fullUser"
            android:configChanges="mcc|mnc|locale|layoutDirection|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|density"
            android:exported="false" />
        <activity android:name=".NativeCaptureReviewActivity"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="fullUser"
            android:configChanges="mcc|mnc|locale|layoutDirection|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|density"
            android:exported="false" />
        <activity android:name=".NativeQueueActivity"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:screenOrientation="fullUser"
            android:configChanges="mcc|mnc|locale|layoutDirection|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|density"
            android:exported="false" />
        <activity android:name=".GraffitiSubmissionActivity"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:screenOrientation="portrait"
            android:exported="false" />
    </application>
</manifest>
