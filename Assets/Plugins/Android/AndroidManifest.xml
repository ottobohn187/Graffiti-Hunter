<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <application android:usesCleartextTraffic="true">
        <activity android:name="com.graffitihunter.demo.HunterHomeActivity"
                  android:theme="@android:style/Theme.Material.NoActionBar"
                  android:screenOrientation="fullUser"
                  android:launchMode="singleTask"
                  android:taskAffinity="com.graffitihunter.demo.home"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.graffitihunter.demo.HunterUnityActivity"
                  android:theme="@style/BaseUnityGameActivityTheme"
                  android:screenOrientation="fullUser"
                  android:process=":capture_review"
                  android:exported="false">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
        <activity android:name="com.graffitihunter.demo.GraffitiSubmissionActivity"
                  android:theme="@android:style/Theme.Material.Light.NoActionBar"
                  android:screenOrientation="portrait"
                  android:exported="false" />
        <activity android:name="com.graffitihunter.demo.NativeCameraCaptureActivity"
                  android:theme="@android:style/Theme.Material.NoActionBar.TranslucentDecor"
                  android:configChanges="orientation|screenSize"
                  android:process=":capture_review"
                  android:exported="false" />
    </application>
</manifest>
